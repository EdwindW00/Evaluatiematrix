# Kopieer dit bestand naar 'secrets.local.ps1' (dat bestand staat in .gitignore — komt
# dus NOOIT in de git-geschiedenis) en vul je eigen waarden in. start-publiek.ps1 leest
# dit bestand automatisch in als het bestaat.

$env:APP_USERNAME = "edwin"
$env:APP_PASSWORD = "verander-dit-wachtwoord"

# Optioneel: AI-instellingen kunnen ook via het Instellingen-scherm in de app zelf,
# maar mogen ook hier gezet worden zodat ze meteen actief zijn bij het opstarten:
# $env:AI_PROVIDER = "openrouter"
# $env:AI_API_KEY = "sk-or-v1-..."
# $env:AI_MODEL = "nvidia/nemotron-3-ultra-550b-a55b:free"
